# ==========================================
# PROVEEDOR DE LLM
# ==========================================
# Opciones: OPENROUTER | OPENAI | GOOGLE | GROQ
LLM_PROVIDER=OPENROUTER

# Modelos recomendados (multimodales, aceptan imágenes + texto):
#   - google/gemini-2.5-flash          (rápido, barato, excelente)
#   - openai/gpt-4o                    (el más capaz)
#   - anthropic/claude-3.5-sonnet      (muy bueno en razonamiento visual)
#   - google/gemini-2.5-flash:free     (gratis, ideal para demos)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_AUDIO_MODEL=openai/gpt-4o-audio-preview

# Alternativas si cambias de proveedor (opcional):
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-1.5-pro
# GROQ_MODEL=llama-3.3-70b-versatile


# ==========================================
# API KEYS
# ==========================================
# OpenRouter (LLM): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu_api_key_aqui

# Groq (STT gratis): https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_de_groq

# Descomenta solo si cambias de proveedor:
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=...

# ==========================================
# LÍMITES DE ARCHIVOS
# ==========================================
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25

# ==========================================
# LOGS
# ==========================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO